# Copy to .env and adjust. Never commit the real .env.

# Generate one: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# On the server this file is required: DJANGO_DEBUG=False with a missing or short key
# makes Django refuse to start rather than boot on the development key.
DJANGO_SECRET_KEY=change-me

# Development values. For the live site set DJANGO_DEBUG=False and list the real domain
# and its subdomains in DJANGO_ALLOWED_HOSTS (no scheme, no trailing slash).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Kampala
LOG_LEVEL=INFO

# sqlite | postgresql
DB_ENGINE=sqlite
# Only used when DB_ENGINE=postgresql. DJANGO_DEBUG=False requires postgresql with all
# four of DB_NAME, DB_USER, DB_HOST, DB_PORT filled in - the app then refuses to boot on
# an incomplete database config instead of failing on the first query.
DB_NAME=mantbridges
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Supabase's connection string is the pooler host (…pooler.supabase.com). Transaction
# pooling cannot hold a server-side cursor, so this stays True unless you connect through
# a session-mode pooler or direct.
#DJANGO_DB_DISABLE_SERVER_SIDE_CURSORS=True
# 0 opens a connection per request, which is what a frozen-between-requests host needs.
# Raise it only on a host with a real process lifetime.
#DJANGO_DB_CONN_MAX_AGE=0

# Supabase Storage, which holds uploaded images, receipt PDFs and message attachments.
# The buckets themselves are named in apps/core/storage_backends.py:
#   mant-public-media  property, service, blog and company artwork (public URLs)
#   mant-private-media receipts and attachments (signed URLs, 300 s expiry)
# The access key and secret are the project's S3-compatible credentials from Supabase.
# Without them the app will not start, because storage is built when the models are read.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=eu-west-1
# Optional; the endpoint defaults to https://<project-ref>.storage.supabase.co/storage/v1/s3
#SUPABASE_S3_ENDPOINT_URL=

# Comma-separated origins allowed to call the API from a browser.
# 5173 = vite dev, 4173 = vite preview
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Console prints emails to the terminal — nothing reaches an inbox with it, and
# /api/manage/email/campaigns/stats/ reports that so the admin UI can say so.
# Swap to django.core.mail.backends.smtp.EmailBackend plus real host/user/password
# for a provider. Never commit those credentials.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@mantbridges.com

# Links inside newsletter emails point here. Use the public site origin in production.
PUBLIC_SITE_URL=http://127.0.0.1:5173
# How long a double opt-in confirmation link stays usable, in hours.
NEWSLETTER_CONFIRM_HOURS=72
# Per-IP limits on the public newsletter endpoints (DRF rate strings).
NEWSLETTER_SUBSCRIBE_RATE=20/min
NEWSLETTER_TOKEN_RATE=60/min

# ---------------------------------------------------------------------------
# Production only. Leave all four unset in development - each one defaults to the
# behaviour above, and each one can lock you out of your own site if it is set on a
# hunch. Check the value against the live host before you set it.
# ---------------------------------------------------------------------------

# The SPA sends a Bearer header, not cookies, so credentialed CORS is never needed.
# Set True only if you add a cookie-based flow.
#CORS_ALLOW_CREDENTIALS=True

# Needed only if the React app is served from a different https origin than the API
# and something sends cookies. Comma-separated, full origins, always with the scheme.
#CSRF_TRUSTED_ORIGINS=https://www.mantbridges.com,https://mantbridges.com

# Lets Django know the host already terminated TLS, so media and email links are built
# as https. The value is "header,value" - cPanel's proxy may forward either one, and
# trusting the wrong header means anyone can spoof it. Confirm with an anonymous request
# first; leave empty if the front end does not forward either.
#DJANGO_TRUSTED_SSL_HEADER=HTTP_X_FORWARDED_PROTO,on

# /api/schema/ and /api/docs/ list every route the platform has, including the desk's.
# Off when DJANGO_DEBUG=False; set True only to debug the API remotely, and turn it off again.
#DJANGO_API_DOCS=True

# Both default off in production. Enable SECURE_SSL_REDIRECT only once https works and
# http:// answering on the same host is acceptable; HSTS is cached by browsers for the
# whole duration and cannot be undone once a visitor has seen it.
#DJANGO_SECURE_SSL_REDIRECT=True
#DJANGO_SECURE_HSTS_SECONDS=31536000

# Ceiling in megabytes for an uploaded file and for the whole request body (default 15).
# Vercel's functions reject a request body above 4.5 MB before Django sees it, so on that
# host set 4 and let the form explain the rejection instead of the platform.
#DJANGO_MAX_UPLOAD_MB=4
