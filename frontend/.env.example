# Copy to .env.local (gitignored) or set in the host's project environment.
# Everything Vite exposes with a VITE_ prefix is inlined into the browser bundle, so this
# file may only ever hold public configuration. No secret belongs here.

# Where the Django API is reached from.
#
# Development: leave it empty. vite.config.js proxies /api and /media to the local Django
# server, so the app stays same-origin and no CORS preflight happens.
#
# Deployed: the frontend and the API are served from different origins, so this has to be
# the backend origin with the API prefix, for example
#   VITE_API_BASE_URL=https://mant-bridges-api.vercel.app/api
# It is read at build time, so changing it on the host means rebuilding the frontend.
VITE_API_BASE_URL=
